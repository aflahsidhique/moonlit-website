# Local dev (SQLite): DATABASE_URL="file:./dev.db"
# Production (Postgres — e.g. Render, Aiven, Supabase, Neon): a postgres://
# connection string. Whichever you use must match datasource.provider in
# prisma/schema.prisma ("sqlite" vs "postgresql") — they're not swappable
# at runtime, only at migration time. See server/README.md for switching.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000

# Seeded on first `npm run seed` — change the password after first login.
ADMIN_EMAIL="admin@moonlitfoundation.org"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Moonlit Admin"

# Comma-separated list of origins allowed to call this API.
# Local dev: the static site is usually opened as file:// or served on a
# local static server (e.g. http://localhost:5500). In production, this is
# the deployed frontend's origin (e.g. https://moonlit-website.onrender.com)
# — see render.yaml.
CORS_ORIGINS="http://localhost:5500,http://127.0.0.1:5500,null"

# Cloudinary — volunteer photo + ID document uploads are stored here.
# Get these from your Cloudinary dashboard (cloudinary.com/console).
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Volunteer portal — linked in the approval email/SMS.
PORTAL_URL="http://localhost:5500/portal/index.html"

# Gmail SMTP — sends the "you're approved" email (volunteer ID + password +
# portal link). GMAIL_USER is the full Gmail address; GMAIL_APP_PASSWORD is
# a 16-character App Password (Google Account → Security → App Passwords —
# requires 2-Step Verification to be enabled). Your normal Gmail password
# will NOT work here. Leave both unset to skip email sending (approval still
# succeeds; the admin panel will just show "email: not configured").
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# SMS Gate (https://sms-gate.app) — sends the same approval details via SMS.
# SMSGATE_BASE_URL is https://api.sms-gate.app/3rdparty/v1 for the hosted
# cloud service, or your own device's local/private URL if self-hosting.
# SMSGATE_USERNAME/PASSWORD are the Basic Auth credentials from your SMS
# Gate account (registered per-device). Leave unset to skip SMS sending.
SMSGATE_BASE_URL="https://api.sms-gate.app/3rdparty/v1"
SMSGATE_USERNAME=""
SMSGATE_PASSWORD=""

# Web Push — generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Do not regenerate after volunteers have subscribed — a new keypair
# invalidates every existing subscription.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
